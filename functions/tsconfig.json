{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": "..",
    "strict": true,
    "target": "ES2017",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@angular/fire/firestore": ["./node_modules/firebase-admin/lib/firestore/index"]
    }
  },
  "compileOnSave": true,
  "include": [
    "src",
    "../app/src/app/core",
    "../app/src/types"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/dev/**",
    "../app/src/app/core/**/*.spec.ts",
    "../app/src/app/core/services/**",
    "../app/src/app/core/plan/plan-solver.service.ts",
    "../app/src/app/core/index.ts"
  ]
}
