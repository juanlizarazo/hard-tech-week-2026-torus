{
  "name": "detour-functions",
  "description": "Cloud Functions for DETOUR",
  "scripts": {
    "build": "tsc",
    "typecheck:dev": "tsc -p tsconfig.dev.json",
    "ingest": "tsx src/dev/ingest-snapshot.ts",
    "ingest:plants": "tsx src/dev/ingest-plants.ts",
    "check:hours": "tsx src/dev/check-hour-labels.ts",
    "snapshot:status": "tsx src/dev/snapshot-admin.ts status",
    "snapshot:pin": "tsx src/dev/snapshot-admin.ts pin",
    "snapshot:unpin": "tsx src/dev/snapshot-admin.ts unpin",
    "snapshot:rollback": "tsx src/dev/snapshot-admin.ts rollback",
    "snapshot:promote": "tsx src/dev/snapshot-admin.ts promote",
    "serve": "yarn build && firebase emulators:start --only functions",
    "shell": "yarn build && firebase functions:shell",
    "start": "yarn shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/firestore": "7.11.6",
    "fflate": "0.8.3",
    "firebase-admin": "13.7.0",
    "firebase-functions": "6.3.2",
    "google-auth-library": "9.15.1"
  },
  "devDependencies": {
    "tsx": "4.19.2",
    "typescript": "5.9.3"
  },
  "private": true
}
