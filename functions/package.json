{
  "name": "detour-functions",
  "description": "Cloud Functions for DETOUR",
  "scripts": {
    "build": "tsc",
    "typecheck:dev": "tsc -p tsconfig.dev.json",
    "serve": "yarn build && firebase emulators:start --only functions",
    "shell": "yarn build && firebase functions:shell",
    "start": "yarn shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "13.7.0",
    "firebase-functions": "6.3.2"
  },
  "devDependencies": {
    "tsx": "4.19.2",
    "typescript": "5.9.3"
  },
  "private": true
}
